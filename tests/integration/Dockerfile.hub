FROM rust:1.86-bookworm AS builder-hub
WORKDIR /build
COPY haproxy-spoa-hub/Cargo.toml haproxy-spoa-hub/Cargo.lock haproxy-spoa-hub/rustfmt.toml ./
COPY haproxy-spoa-hub/crates/ crates/
COPY haproxy-spoa-hub/examples/ examples/
RUN cargo build --release -p haproxy-spoa-hub

FROM rust:1.86-bookworm AS builder-plugin
WORKDIR /deps
COPY haproxy-spoa-hub/Cargo.toml haproxy-spoa-hub/Cargo.lock haproxy-spoa-hub/rustfmt.toml ./
COPY haproxy-spoa-hub/crates/ crates/
COPY haproxy-spoa-hub/examples/ examples/
WORKDIR /build
COPY haproxy-spoa-hub-plugin-fingerprinting/Cargo.toml haproxy-spoa-hub-plugin-fingerprinting/Cargo.lock ./
COPY haproxy-spoa-hub-plugin-fingerprinting/src/ src/
COPY haproxy-spoa-hub-plugin-fingerprinting/benches/ benches/
RUN sed -i 's|path = "../haproxy-spoa-hub/crates/plugin-api"|path = "/deps/crates/plugin-api"|' Cargo.toml
RUN cargo build --release

FROM debian:bookworm-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends libgcc-s1 \
    && rm -rf /var/lib/apt/lists/*
RUN mkdir -p /etc/haproxy-spoa-hub/plugins
COPY --from=builder-hub /build/target/release/haproxy-spoa-hub /usr/local/bin/
COPY --from=builder-plugin /build/target/release/libfingerprinting_plugin.so /etc/haproxy-spoa-hub/plugins/
ENTRYPOINT ["haproxy-spoa-hub"]
CMD ["--config", "/etc/haproxy-spoa-hub/config.toml"]
